# remotevibe configuration. Copy to .env (gitignored) and fill in.
# On the VPS this file lives at /etc/remotevibe.env, mode 0600, root-owned.

# --- required ---------------------------------------------------------------

# Fine-grained GitHub PAT. Needs "Contents: read & write" on the repositories
# you want to hack on, plus "Metadata: read". Read/write because the same token
# clones the repo AND pushes the agent's commits back.
RV_GITHUB_TOKEN=github_pat_xxx

# --- agent authentication ---------------------------------------------------

# seeded      sign in once with `make auth`; the resulting profile is copied
#             into each new session's own volume. One login ever, sessions stay
#             independent afterwards. This is the mode the phone flow needs.
# shared-home every session mounts that one profile directly: nothing to seed,
#             refreshes shared, one config file they all write to.
# token       forwards a long-lived token from `claude setup-token` and seeds
#             nothing. May not be enough on its own — Remote Control also wants
#             an account record that only a sign-in produces.
#
# No mode uses the Anthropic API; they all ride your Claude subscription. See
# README "Authentication", and run scripts/verify-remote-control.sh after any
# change here.
RV_AUTH_MODE=seeded
CLAUDE_CODE_OAUTH_TOKEN=

# --- optional ---------------------------------------------------------------

# Bind to localhost and let `tailscale serve` terminate TLS on the tailnet.
RV_ADDR=127.0.0.1:8787

# Host directory for the shared agent home (shared-home mode only).
RV_STATE_DIR=/var/lib/remotevibe

RV_AGENT_IMAGE=remotevibe/agent:latest

# Volume name prefixes. Each session gets <ws>-<slug> for the checkout and
# <home>-<slug> for the agent's own state, so a restart resumes the session.
RV_VOLUME_PREFIX=rv-ws-
RV_HOME_VOLUME_PREFIX=rv-home-

# Permission mode for the agent. You cannot tap "approve" on every tool call
# from a phone, and the container is the sandbox — so this defaults to
# bypassPermissions. Set acceptEdits if you want command approvals back.
RV_PERMISSION_MODE=bypassPermissions

# Prefix for the session name shown in the phone app, e.g. "vps" renders as
# "vps/my-repo". Leave empty to show just the repository name.
RV_SESSION_PREFIX=

# Model override (e.g. claude-opus-5) and any extra agent CLI flags.
RV_MODEL=
RV_AGENT_EXTRA_ARGS=

# Per-session resource caps, passed to docker run. Empty means unlimited.
RV_CPUS=
RV_MEMORY=

# Commit identity used inside containers.
RV_GIT_NAME=remotevibe
RV_GIT_EMAIL=remotevibe@localhost
